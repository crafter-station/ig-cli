{
  "name": "@jibaru/ig-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for Instagram creator research: discover creators, track reel metrics, find top videos, download them.",
  "keywords": [
    "instagram",
    "cli",
    "reels",
    "creators",
    "agent",
    "ai-agents",
    "scraper",
    "research"
  ],
  "homepage": "https://github.com/crafter-station/ig-cli#readme",
  "bugs": {
    "url": "https://github.com/crafter-station/ig-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/ig-cli.git"
  },
  "license": "MIT",
  "author": "Crafter Station",
  "type": "module",
  "bin": {
    "ig": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "registries": {
    "@cligentic": "https://cligentic.railly.dev/r/{name}.json"
  }
}
